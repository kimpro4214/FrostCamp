[gd_scene format=3]

[ext_resource type="Script" path="res://frost_camp/ui/hud.gd" id="1_script"]
[ext_resource type="Script" path="res://frost_camp/ui/virtual_joystick.gd" id="2_joystick"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_script")

[node name="Joystick" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("2_joystick")

[node name="Top" type="HBoxContainer" parent="."]
anchors_preset = 10
anchor_right = 1.0
offset_left = 16.0
offset_top = 16.0
offset_right = -16.0
offset_bottom = 64.0
grow_horizontal = 2
theme_override_constants/separation = 32
alignment = 1

[node name="Money" type="Label" parent="Top"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.2, 1)
theme_override_colors/font_outline_color = Color(0.1, 0.1, 0.15, 1)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 36
text = "$ 0"

[node name="Stack" type="Label" parent="Top"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0.1, 0.1, 0.15, 1)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 36
text = "0 / 10"

[node name="Hp" type="Label" parent="Top"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.55, 0.5, 1)
theme_override_colors/font_outline_color = Color(0.1, 0.1, 0.15, 1)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 36
text = "HP 10"
